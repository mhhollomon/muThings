# ./mupic  ./tests/land-cover-square.mupic

# landscape cover to square on landscape output with margin and border.

output {
  size = 1920x1080
  path = ../test-out/land-cover-square.png
}

cover {
  fit = square
  path = resources/landscape-mode.png
  margin = 100
  align = max
  crop = mid
  border = blue, 100
}
