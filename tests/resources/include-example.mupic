include "ex-inc.mupic"

default fill "rosy_red"

output {
    path = "path"
    color = some-color
    background = "path"
    margin = 10
    border {
        color = "color"
        width { 5 }
    }
}


image "name" {
    path = "path"
    size = 200
    mask = auto
    position = "right-bottom"
}

text "unique_name" {
    text = "My Text"
    size = 200
    position = "pixel(40%, 40%)"
    rotation = 0
    fill = "hsv(0,0%,100%)"
    stroke {
        color = "green"
        width = 2
    }
    font = "some-font-resource"
}

# Unnamed text element
text {
    text = "Sneaky"
    size = 100
    position = "center-center"
}

# unnamed image element
image {
    path = "path2"
    size = 400x500
    position = "border(min, min, left)"
}

text "title" {
    text = "Groovy Track"
    size = 100
    position = "left-top"
}
