
output {
    size = 1920x1080
    color = white
    path = test-out/margins.png
}

image "center" {
    size = 400x400
    margin = 10
    color = blue
    position = "overlay(output, mid, mid, mid, mid)"
}

image "left" {
    size = 250x250
    margin = 10
    color = red
    position = "attach(center, left, mid, mid)"
}

image "left_left" {
    size = 100x100
    margin = 10
    color = red
    position = "attach(left, left, min, min)"
}

image "left_left_max" {
    size = 100x100
    margin = 10
    color = red
    position = "attach(left, left, max, max)"
}

image "right" {
    size = 250x250
    margin = 10
    color = green
    position = "attach(center, right, mid, mid)"
}

image "right_right" {
    size = 100x100
    margin = 10
    color = red
    position = "attach(right, right, min, min)"
}

image "right_right_max" {
    size = 100x100
    margin = 10
    color = red
    position = "attach(right, right, max, max)"
}

image "top" {
    size = 250x250
    margin = 10
    color = red
    position = "attach(center, top, mid, mid)"
}

image "top_top" {
    size = 100x100
    margin = 10
    color = red
    position = "attach(top, top, min, min)"
}


image "bottom" {
    size = 250x250
    margin = 10
    color = green
    position = "attach(center, bottom, mid, mid)"
}

image "bottom_bottom" {
    size = 100x100
    margin = 10
    color = red
    position = "attach(bottom, bottom, min, min)"
}
