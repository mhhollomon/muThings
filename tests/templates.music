output {
    size = 1920x1080
    color = white
    path = ../test-out/templates.png
    border = black, 2
}

image starter {
    size = 600x600
    color = blue
    position = "output(min, mid, 20)"
}

template t(i, o) {{{ 
    image b$i {
        size = scale, 0.7
        position = "attach($p, right, mid, mid, $o)"
        color = "hsv($i0, 50%, 80%)"
    }
}}}

render t(1, 10)
render t(2, 20)
render t(3, 30)
render t(4, 40)

