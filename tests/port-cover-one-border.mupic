# ./mupic ./tests/port-cover-one-border.mupic

# landscape cover to square on portrait output with margin and border.
# but only one border side

output {
  size = 1080x1920
  path = ../test-out/port-cover-one-border.png
}

cover {
  fit = square
  path = "resources/landscape-mode.png"
  margin = 100
  crop = mid
  align = min
  border {
    width  {l=100}
    color = blue
  }
}
